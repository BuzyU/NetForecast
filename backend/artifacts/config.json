{
  "window": 6,
  "features": [
    "flow_duration",
    "tot_fwd_pkts",
    "tot_bwd_pkts",
    "fwd_pkt_len_mean",
    "bwd_pkt_len_mean",
    "flow_bytes_s",
    "flow_pkts_s",
    "flow_iat_mean",
    "flow_iat_std",
    "fwd_iat_mean",
    "bwd_iat_mean",
    "syn_flag_cnt",
    "ack_flag_cnt",
    "fin_flag_cnt",
    "rst_flag_cnt",
    "psh_flag_cnt",
    "urg_flag_cnt",
    "down_up_ratio",
    "pkt_size_avg",
    "ttl_variance",
    "tcp_win_size",
    "retransmit_cnt"
  ],
  "stages": [
    "Benign",
    "Reconnaissance",
    "Initial Access",
    "Lateral Movement",
    "C2",
    "Exfiltration"
  ],
  "hidden_size": 256,
  "num_layers": 2,
  "lstm_dropout": 0.25,
  "provenance": {
    "trained_on": "real_flows.csv",
    "train_sessions": 1600,
    "test_sessions": 401,
    "train_rows": 269974,
    "test_rows": 61566,
    "git_commit": "7b47c3e",
    "leakage_fix": "session-level split, scaler fit on train only",
    "synthetic_augmentation": {
      "stages": [
        "Exfiltration"
      ],
      "sessions_per_stage": 300,
      "note": "train-only synthetic oversampling from calibrated per-stage feature profiles; test set is 100% real flows (CIC-IDS2017 and, if present, CIC-IDS2018), untouched by synthetic augmentation"
    },
    "class_weight_max": 8.0,
    "stage_loss": "focal",
    "focal_gamma": 2.0,
    "best_val_f1": 0.8652,
    "optimization": "AdamW + CosineAnnealingLR + ClassWeighting"
  }
}